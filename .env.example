# 复制为 .env 并填你自己的值（server.mjs 会用 process.env，也可直接在启动前 export）
# 注意：.env 不要提交进 Git
PORT=8765
HOST=127.0.0.1
# OpenAI 兼容接口（阿里百炼 Qwen 推荐，DeepSeek / 智谱 GLM 也可）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=qwen-flash
# 高德 Web 服务 API Key（地理编码）
AMAP_KEY=xxxxxxxx
